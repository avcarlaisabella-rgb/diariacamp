# PostgreSQL na VPS Hostinger (ajuste host/usuário/senha/banco)
# Exemplo local (docker-compose): postgresql://diariacamp:diariacamp@localhost:5432/diariacamp?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/diariacamp?schema=public"

# Segredo usado para assinar o cookie de sessão (gere um valor aleatório forte)
# Ex.: openssl rand -base64 32
SESSION_SECRET="troque-por-um-valor-aleatorio-forte"

# URL pública da aplicação (usada em links/callbacks se necessário)
APP_URL="http://localhost:3000"
